# The same in every crew project (mqucifer/project-template). A project adds
# its own below; the crew also excludes OS and cache files in every worktree.

# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# The crew's sandbox: each worktree's home, and what setup fetches
.crew-home/
.package/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Node
node_modules/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
